@namespace JeDax.Components.Shared
@inject CurrentUser Current

<nav class="navbar">
    <span class="brand">JeDax</span>
    @if (Current.IsAuthenticated && Current.User is not null)
    {
        @if (Permisos.PuedeUsarIngreso(Current.User.Rol))
        {
            <a href="/ingreso" class="nav-link"><Icon Name="ingreso" Size="16" /><span>Ingreso</span></a>
        }
        @if (Permisos.PuedeVerStock(Current.User.Rol))
        {
            <a href="/stock" class="nav-link"><Icon Name="stock" Size="16" /><span>Stock</span></a>
        }
        @if (Permisos.PuedeMoverInventario(Current.User.Rol))
        {
            <a href="/move" class="nav-link"><Icon Name="mover" Size="16" /><span>Mover</span></a>
        }
        @if (Permisos.PuedeRegistrarSalidas(Current.User.Rol))
        {
            <a href="/salidas" class="nav-link"><Icon Name="salidas" Size="16" /><span>Salidas</span></a>
        }
        @if (Permisos.PuedeVerImportarVales(Current.User.Rol))
        {
            <a href="/vales" class="nav-link"><Icon Name="vales" Size="16" /><span>Vales</span></a>
        }
        <a href="/historial" class="nav-link"><Icon Name="historial" Size="16" /><span>Historial</span></a>
        @if (Permisos.PuedeVerBitacora(Current.User.Rol))
        {
            <a href="/bitacora" class="nav-link"><Icon Name="truck" Size="16" /><span>Bitácora</span></a>
        }
        @if (Permisos.PuedeAccederCaseGenerador(Current.User.Rol))
        {
            <a href="/case-generador" class="nav-link"><Icon Name="case-gen" Size="16" /><span>CASE Gen</span></a>
        }
        @if (Permisos.PuedeAdministrarUsuarios(Current.User.Rol))
        {
            <a href="/admin" class="nav-link"><Icon Name="admin" Size="16" /><span>Admin</span></a>
        }
        <span class="nav-user"><Icon Name="user" Size="14" /> @Current.User.Username</span>
        <form method="post" action="/api/logout" style="display:inline;margin:0">
            <button type="submit" class="nav-logout" title="Salir">
                <Icon Name="logout" Size="16" />
            </button>
        </form>
    }
    else
    {
        <a href="/login">Iniciar sesión</a>
    }
</nav>
