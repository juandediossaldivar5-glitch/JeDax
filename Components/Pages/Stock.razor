@page "/stock"
@using JeDax.Components.Shared
@inject InventarioService Inventario

<h1><Icon Name="stock" Size="32" /> Stock</h1>

@if (_resumen is not null)
{
    <div class="cards-row">
        <div class="card">
            <span class="card-num">@_resumen.TotalCasesEnStock</span>
            <span class="card-lbl"><Icon Name="box" Size="12" /> Cases en stock</span>
        </div>
        <div class="card">
            <span class="card-num">@_resumen.TotalPiezasEnStock</span>
            <span class="card-lbl"><Icon Name="hash" Size="12" /> Piezas totales</span>
        </div>
        <div class="card">
            <span class="card-num">@_resumen.CasesUbicados</span>
            <span class="card-lbl"><Icon Name="map-pin" Size="12" /> Ubicados</span>
        </div>
        <div class="card warn">
            <span class="card-num">@_resumen.CasesSinUbicar</span>
            <span class="card-lbl"><Icon Name="info" Size="12" /> Sin ubicar</span>
        </div>
    </div>
}

<form method="get" class="toolbar" style="display:flex;gap:.75rem;align-items:center;flex-wrap:wrap">
    <input name="q" value="@Q" placeholder="Buscar CASE / Item / Ubicación…" class="input" />
    <button type="submit" class="btn-outline"><Icon Name="search" Size="14" /> Buscar</button>
    <a href="/api/export/stock" class="btn-outline" style="margin-left:auto"><Icon Name="download" Size="14" /> Exportar Excel</a>
</form>

@if (_casesFiltrados.Count == 0)
{
    <div class="empty-state">
        <Icon Name="empty-box" Size="120" />
        <h3>Sin resultados</h3>
        <p>@(string.IsNullOrEmpty(Q) ? "Aún no hay CASEs en el almacén. Ve a Ingreso para registrar el primero." : "Ningún CASE coincide con tu búsqueda.")</p>
        @if (string.IsNullOrEmpty(Q))
        {
            <a href="/ingreso" class="btn-primary" style="text-decoration:none;margin-top:1rem;display:inline-block"><Icon Name="ingreso" Size="16" /> Registrar primer CASE</a>
        }
    </div>
}
else
{
    <p style="color:var(--muted);font-size:12px;margin:.75rem 0"><Icon Name="info" Size="12" /> @_casesFiltrados.Count cases encontrados</p>
    <table class="tabla">
        <thead>
            <tr><th>CASE</th><th>Item</th><th>Descripción</th><th>Ubicación</th><th>Qty Inicial</th><th>Qty Actual</th><th>Ref. Entrada</th><th>Estado</th><th>Fecha</th></tr>
        </thead>
        <tbody>
            @foreach (var c in _casesFiltrados)
            {
                <tr class="@(c.Estado == EstadoCase.Recibido ? "row-warn" : "")">
                    <td>@c.CaseCode</td>
                    <td>@c.Producto.Item</td>
                    <td>@c.Producto.Descripcion</td>
                    <td>@UbicacionFormatter.Display(c.Ubicacion)</td>
                    <td>@c.QtyInicial</td>
                    <td>@c.QtyActual</td>
                    <td>@c.RefEntrada</td>
                    <td><span class="badge badge-@c.Estado.ToString().ToLower()">@c.Estado</span></td>
                    <td>@c.FechaRegistro.ToLocalTime().ToString("dd/MM/yy HH:mm")</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    [SupplyParameterFromQuery] public string? Q { get; set; }

    ResumenStock? _resumen;
    List<Case> _casesFiltrados = [];

    protected override async Task OnInitializedAsync()
    {
        _resumen = await Inventario.ObtenerResumenAsync();
        var cases = await Inventario.ObtenerStockActivoAsync();
        if (string.IsNullOrWhiteSpace(Q))
        {
            _casesFiltrados = cases;
        }
        else
        {
            string f = Q.ToUpperInvariant();
            _casesFiltrados = cases.Where(c =>
                c.CaseCode.Contains(f) || c.Producto.Item.Contains(f) ||
                c.Producto.Descripcion.ToUpperInvariant().Contains(f) ||
                (c.Ubicacion?.Contains(f) ?? false) || (c.RefEntrada?.Contains(f) ?? false)
            ).ToList();
        }
    }
}
