@page "/ingreso"
@inject CurrentUser Current

<h1>Ingreso de CASE</h1>

@if (!string.IsNullOrEmpty(Error))
{
    <div class="alert-error">@Error</div>
}

<form method="post" action="/api/inventario/entrada" class="form-section">
    <label>CASE code</label>
    <input name="caseCode" required autofocus class="input" placeholder="CASE00000000" />

    <label>Item (part number)</label>
    <input name="item" required class="input" />

    <label>Descripción</label>
    <input name="descripcion" required class="input" />

    <label>Cantidad</label>
    <input type="number" name="qty" required min="1" value="1" class="input" />

    <label>Referencia de entrada (vale/invoice)</label>
    <input name="refEntrada" required class="input" />

    <button type="submit" class="btn-primary">Registrar entrada</button>
</form>

@code {
    [SupplyParameterFromQuery] public string? Error { get; set; }
}
