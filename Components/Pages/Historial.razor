@page "/historial"
@using JeDax.Components.Shared
@inject InventarioService Inventario

<h1><Icon Name="historial" Size="32" /> Historial de Movimientos</h1>
<p style="color:var(--muted);margin-bottom:2rem;max-width:600px">
    Bitácora completa de entradas, salidas y movimientos de ubicación.
</p>

<form method="get" class="toolbar" style="display:flex;gap:.75rem;align-items:center;flex-wrap:wrap;margin-bottom:1rem">
    <input name="q" value="@Q" placeholder="Buscar CASE / Item / Referencia…" class="input" />
    <select name="tipo" class="input" style="max-width:180px">
        <option value="" selected="@(string.IsNullOrEmpty(Tipo))">Todos los tipos</option>
        <option value="Entrada" selected="@(Tipo == "Entrada")">Entrada</option>
        <option value="Salida" selected="@(Tipo == "Salida")">Salida</option>
        <option value="Ubicacion" selected="@(Tipo == "Ubicacion")">Ubicación</option>
    </select>
    <button type="submit" class="btn-outline"><Icon Name="search" Size="14" /> Filtrar</button>
    <a href="/api/export/historial" class="btn-outline" style="margin-left:auto"><Icon Name="download" Size="14" /> Exportar</a>
</form>

@if (_filtrados.Count == 0)
{
    <div class="empty-state">
        <Icon Name="historial" Size="80" />
        <h3>Sin movimientos</h3>
        <p>No se encontraron movimientos con los filtros actuales.</p>
    </div>
}
else
{
    <p style="color:var(--muted);font-size:12px;margin-bottom:.75rem"><Icon Name="info" Size="12" /> @_filtrados.Count registros</p>
    <table class="tabla">
        <thead>
            <tr><th>Fecha</th><th>Tipo</th><th>CASE</th><th>Item</th><th>Descripción</th><th>Qty</th><th>Referencia</th><th>Ubicación</th><th>Usuario</th></tr>
        </thead>
        <tbody>
            @foreach (var m in _filtrados.Take(500))
            {
                <tr>
                    <td>@m.Fecha.ToLocalTime().ToString("dd/MM/yy HH:mm")</td>
                    <td><span class="badge badge-mov-@m.Tipo.ToString().ToLower()">@m.Tipo</span></td>
                    <td>@m.CaseCode</td>
                    <td>@m.Item</td>
                    <td>@m.Descripcion</td>
                    <td>@m.Qty</td>
                    <td>@(m.Tipo == TipoMovimiento.Ubicacion ? UbicacionFormatter.Display(m.Referencia) : m.Referencia)</td>
                    <td>@UbicacionFormatter.Display(m.Ubicacion)</td>
                    <td>@m.Usuario</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    [SupplyParameterFromQuery] public string? Q { get; set; }
    [SupplyParameterFromQuery] public string? Tipo { get; set; }

    List<MovimientoHistorico> _filtrados = [];

    protected override async Task OnInitializedAsync()
    {
        var q = await Inventario.ObtenerMovimientosAsync();
        if (!string.IsNullOrWhiteSpace(Tipo) && Enum.TryParse<TipoMovimiento>(Tipo, out var t))
            q = q.Where(m => m.Tipo == t).ToList();
        if (!string.IsNullOrWhiteSpace(Q))
        {
            string f = Q.ToUpperInvariant();
            q = q.Where(m => m.CaseCode.Contains(f) || m.Item.Contains(f) ||
                              m.Referencia.Contains(f) || m.Usuario.ToUpperInvariant().Contains(f)).ToList();
        }
        _filtrados = q;
    }
}
