@page "/case-generador"
@using JeDax.Components.Shared
@inject CaseGeneradorService GeneradorSvc

<h1><Icon Name="case-gen" Size="32" /> Generador de CASE</h1>
<p style="color:var(--muted);margin-bottom:2rem;max-width:600px">
    Genera bloques de códigos CASE secuenciales listos para imprimir en etiquetas.
</p>

<form method="get" class="form-section">
    <label><Icon Name="hash" Size="12" /> Desde (número de inicio)</label>
    <input name="desde" type="number" required class="input" value="@(Desde ?? 858000)" />
    <label><Icon Name="hash" Size="12" /> Cantidad (máx 5000)</label>
    <input name="cantidad" type="number" required class="input" min="1" max="5000" value="@(Cantidad ?? 100)" />
    <button type="submit" class="btn-primary"><Icon Name="check" Size="16" /> Generar códigos</button>
</form>

@if (_codigos.Count > 0)
{
    <div style="margin-top:2rem">
        <a href="/api/case-generador/download?desde=@Desde&cantidad=@Cantidad" class="btn-outline">
            <Icon Name="download" Size="14" /> Descargar .txt para etiquetas
        </a>
        <p style="color:var(--muted);font-size:12px;margin:1rem 0">
            <Icon Name="info" Size="12" /> @_codigos.Count códigos generados.
            @if (_existentes.Count > 0)
            {
                <span style="color:var(--red)"> @_existentes.Count ya existen en BD (marcados en rojo).</span>
            }
        </p>
        <div class="code-list">
            @foreach (var c in _codigos)
            {
                <span class="code-item @(_existentes.Contains(c) ? "code-existe" : "")">@c</span>
            }
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery] public int? Desde { get; set; }
    [SupplyParameterFromQuery] public int? Cantidad { get; set; }

    List<string> _codigos = [];
    HashSet<string> _existentes = [];

    protected override async Task OnInitializedAsync()
    {
        if (Desde is null || Cantidad is null) return;
        if (Cantidad <= 0 || Cantidad > 5000) return;
        _codigos = CaseGeneradorService.GenerarCodigos(Desde.Value, Cantidad.Value);
        _existentes = await GeneradorSvc.FiltrarExistentesAsync(_codigos);
    }
}
