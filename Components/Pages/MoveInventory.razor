@page "/move"
@inject InventarioService Inventario

<h1>Mover Inventario</h1>

@if (!string.IsNullOrEmpty(Error))
{
    <div class="alert-error">@Error</div>
}
@if (Ok == "1" && !string.IsNullOrEmpty(Code))
{
    <div class="alert-ok">CASE @Code movido correctamente.</div>
}

<form method="post" action="/api/inventario/mover" class="form-section">
    <label>CASE code</label>
    <input name="caseCode" required autofocus class="input" placeholder="CASE00000000" value="@Code" />

    <label>Nueva ubicación (formato XXXX/XXX/NNNNNN)</label>
    <input name="ubicacion" required class="input" placeholder="A001/B02/000001" />

    <button type="submit" class="btn-primary">Mover</button>
</form>

@if (_ubicaciones.Count > 0)
{
    <div style="margin-top:1.5rem">
        <h3>Ubicaciones existentes (últimas)</h3>
        <div class="code-list">
            @foreach (var u in _ubicaciones.Take(30))
            {
                <span class="code-item">@u</span>
            }
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery] public string? Error { get; set; }
    [SupplyParameterFromQuery] public string? Ok { get; set; }
    [SupplyParameterFromQuery] public string? Code { get; set; }

    List<string> _ubicaciones = [];

    protected override async Task OnInitializedAsync()
    {
        _ubicaciones = await Inventario.ObtenerUbicacionesExistentesAsync();
    }
}
