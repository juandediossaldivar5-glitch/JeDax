@page "/salidas"

<h1>Registro de Salidas</h1>

@if (!string.IsNullOrEmpty(Error))
{
    <div class="alert-error">@Error</div>
}

<form method="post" action="/api/inventario/salida" class="form-section">
    <label>CASE code</label>
    <input name="caseCode" required autofocus class="input" placeholder="CASE00000000" />

    <label>Referencia de salida</label>
    <input name="refSalida" required class="input" />

    <label>Cantidad (0 = salida total)</label>
    <input type="number" name="qty" required min="0" value="0" class="input" />

    <button type="submit" class="btn-primary">Registrar salida</button>
</form>

@code {
    [SupplyParameterFromQuery] public string? Error { get; set; }
}
