@page "/login"
@using JeDax.Components.Shared

<div class="login-hero">
    <div class="login-illustration">
        <Icon Name="warehouse" Size="120" />
    </div>
    <h1 style="text-align:center">Bienvenido a JeDax</h1>
    <p style="text-align:center;color:var(--muted);margin-bottom:2rem;max-width:400px;margin-left:auto;margin-right:auto">
        Ingresa a tu almacén — controla stock, ingresos, salidas y ubicaciones en segundos.
    </p>

    @if (Error == "1")
    {
        <div class="alert-error" style="max-width:460px;margin:0 auto 1rem">
            <Icon Name="info" Size="18" /> Credenciales incorrectas. Verifica empresa, usuario y contraseña.
        </div>
    }

    <form method="post" action="/api/login" class="form-login" style="margin:0 auto">
        <label><Icon Name="building" Size="12" /> Empresa</label>
        <input type="text" name="slug" placeholder="ej: laredo" class="input" required autofocus />

        <label><Icon Name="user" Size="12" /> Usuario</label>
        <input type="text" name="username" placeholder="JUAN_ADM" class="input" required />

        <label><Icon Name="lock" Size="12" /> Contraseña</label>
        <input type="password" name="password" placeholder="••••••••" class="input" required />

        <button type="submit" class="btn-primary">Entrar</button>
    </form>
</div>

@code {
    [SupplyParameterFromQuery] public string? Error { get; set; }
}
