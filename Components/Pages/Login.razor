@page "/login"

<h1>Iniciar sesión</h1>

@if (Error == "1")
{
    <div class="alert-error">Credenciales incorrectas.</div>
}

<form method="post" action="/api/login" class="form-login">
    <input type="text" name="slug" placeholder="Empresa (slug)" class="input" required autofocus />
    <input type="text" name="username" placeholder="Usuario" class="input" required />
    <input type="password" name="password" placeholder="Contraseña" class="input" required />
    <button type="submit" class="btn-primary">Entrar</button>
</form>

@code {
    [SupplyParameterFromQuery] public string? Error { get; set; }
}
