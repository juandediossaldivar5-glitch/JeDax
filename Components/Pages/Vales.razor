@page "/vales"
@inject ValeService ValesSvc

<h1>Vales</h1>

@if (!string.IsNullOrEmpty(Error))
{
    <div class="alert-error">@Error</div>
}
@if (Ok == "1")
{
    <div class="alert-ok">Operación exitosa.</div>
}

<form method="get" class="toolbar" style="display:flex;gap:.75rem;align-items:center;flex-wrap:wrap">
    <select name="tipo" class="input" style="max-width:160px">
        <option value="" selected="@(string.IsNullOrEmpty(Tipo))">Todos tipos</option>
        <option value="Entrada" selected="@(Tipo == "Entrada")">Entrada</option>
        <option value="Salida" selected="@(Tipo == "Salida")">Salida</option>
    </select>
    <select name="estado" class="input" style="max-width:160px">
        <option value="" selected="@(string.IsNullOrEmpty(Estado))">Todos estados</option>
        <option value="Open" selected="@(Estado == "Open")">Open</option>
        <option value="Cerrado" selected="@(Estado == "Cerrado")">Cerrado</option>
        <option value="Cancelado" selected="@(Estado == "Cancelado")">Cancelado</option>
    </select>
    <button type="submit" class="btn-outline">Filtrar</button>
    <a href="/api/export/vales" class="btn-outline" style="margin-left:auto;text-decoration:none">↓ Exportar</a>
</form>

<div style="margin:1rem 0;padding:1rem;background:var(--surface);border-radius:var(--radius)">
    <h3 style="margin-top:0">Importar vales desde Excel</h3>
    <form method="post" action="/api/vales/importar" enctype="multipart/form-data" style="display:flex;gap:.75rem;align-items:center">
        <input type="file" name="archivo" accept=".xlsx" required class="input" style="max-width:400px" />
        <button type="submit" class="btn-primary">Importar</button>
    </form>
</div>

@if (_vales.Count == 0)
{
    <p>Sin vales.</p>
}
else
{
    <table class="tabla">
        <thead>
            <tr><th>Referencia</th><th>Tipo</th><th>Estado</th><th>Creado por</th><th>Fecha</th><th>Detalles</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var v in _vales)
            {
                <tr>
                    <td>@v.Referencia</td>
                    <td><span class="badge">@v.Tipo</span></td>
                    <td><span class="badge badge-estado-@v.Estado.ToString().ToLower()">@v.Estado</span></td>
                    <td>@v.CreadoPor</td>
                    <td>@v.FechaCreacion.ToLocalTime().ToString("dd/MM/yy HH:mm")</td>
                    <td>@v.Detalles.Count (@v.Detalles.Count(d => d.Procesado) procesados)</td>
                    <td>
                        @if (v.Estado == EstadoVale.Open)
                        {
                            <form method="post" action="/api/vales/cancelar" style="display:inline">
                                <input type="hidden" name="valeId" value="@v.Id" />
                                <button type="submit" class="btn-sm btn-sm-danger" onclick="return confirm('¿Cancelar vale?')">Cancelar</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    [SupplyParameterFromQuery] public string? Tipo { get; set; }
    [SupplyParameterFromQuery] public string? Estado { get; set; }
    [SupplyParameterFromQuery] public string? Error { get; set; }
    [SupplyParameterFromQuery] public string? Ok { get; set; }

    List<Vale> _vales = [];

    protected override async Task OnInitializedAsync()
    {
        TipoVale? t = Enum.TryParse<TipoVale>(Tipo, out var tv) ? tv : null;
        EstadoVale? e = Enum.TryParse<EstadoVale>(Estado, out var ev) ? ev : null;
        _vales = await ValesSvc.ListarAsync(t, e);
    }
}
