@page "/sakuma-etiquetas"
@using JeDax.Components.Shared
@using JeDax.Helpers
@inject ValeService ValesSvc

@if (_detalles.Count == 0)
{
    <div class="empty-state">
        <Icon Name="empty-box" Size="80" />
        <h3>Sin etiquetas</h3>
        <p>No se encontraron CASEs para esta referencia.</p>
        <a href="/vales" class="btn-primary">Ir a Vales</a>
    </div>
}
else
{
    <div class="no-print toolbar-et">
        <span><strong>@Ref</strong> — @_detalles.Count etiquetas</span>
        <button onclick="window.print()" class="btn-primary"><Icon Name="download" Size="16" /> Imprimir</button>
        <a href="/vales" class="btn-outline">Ir a Vales</a>
    </div>

    @foreach (var d in _detalles)
    {
        <div class="et-page">

            <!-- Marca de agua "JeDax" — tenue, detrás del contenido -->
            <div class="et-watermark" aria-hidden="true">JeDax</div>

            <!-- QR + código legible -->
            <div class="et-qr-row">
                <img class="et-qr"
                     src="data:image/png;base64,@QrHelper.ToBase64Png(d.CaseCode, 6)"
                     alt="QR @d.CaseCode" />
                <div class="et-qr-text">@d.CaseCode</div>
            </div>

            <!-- CASE number principal -->
            <div class="et-case-box">@d.CaseCode</div>

            <!-- Labels -->
            <div class="et-labels-row">
                <span>ITEM NO.</span>
                <span>QTY</span>
            </div>

            <!-- Item + QTY -->
            <div class="et-data-row">
                <div class="et-item-box">@(d.Item ?? "")</div>
                <div class="et-qty-box">@d.Qty</div>
            </div>

            <!-- DESCRIPCIÓN -->
            <div class="et-section-label">DESCRIPCIÓN</div>
            <div class="et-desc-box">@(d.Descripcion ?? "")</div>

            <!-- IN DATE -->
            <div class="et-section-label">IN DATE</div>
            <div class="et-date-row">
                <div class="et-date-box">
                    @((d.FechaProcesado ?? DateTime.UtcNow).ToString("yyyy-MM-dd"))
                </div>
            </div>

        </div>
    }
}

<style>
    /* ── Toolbar (solo pantalla) ─────────────────────────── */
    .toolbar-et {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
    }

    /* ── Página de etiqueta ──────────────────────────────── */
    .et-page {
        position: relative;
        width: 100%;
        max-width: 900px;
        margin: 0 auto 3rem;
        font-family: Calibri, 'Segoe UI', Arial, sans-serif;
        color: #000;
        background: white;
        padding: 1.2rem 1.5rem .8rem;
        break-after: page;
        page-break-after: always;
    }

    /* Marca de agua: oculta en pantalla, visible al imprimir */
    .et-watermark {
        display: none;
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%) rotate(-35deg);
        font-size: 9rem;
        font-weight: 900;
        color: rgba(0, 0, 0, 0.045);
        pointer-events: none;
        user-select: none;
        white-space: nowrap;
        z-index: 0;
        font-family: Calibri, Arial, sans-serif;
    }

    /* Todo el contenido de la etiqueta encima de la marca */
    .et-qr-row,
    .et-case-box,
    .et-labels-row,
    .et-data-row,
    .et-section-label,
    .et-desc-box,
    .et-date-row {
        position: relative;
        z-index: 1;
    }

    /* QR + código legible */
    .et-qr-row {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        margin-bottom: .4rem;
    }

    .et-qr {
        width: 130px;
        height: 130px;
        image-rendering: pixelated;
    }

    .et-qr-text {
        font-size: 10pt;
        margin-top: .15rem;
        letter-spacing: .03em;
    }

    /* CASE number grande */
    .et-case-box {
        border: 2.5px solid #000;
        text-align: center;
        font-size: clamp(2.5rem, 6vw, 4.8rem);
        font-weight: bold;
        padding: .5rem;
        margin-bottom: .5rem;
        line-height: 1.1;
        letter-spacing: .05em;
    }

    /* Labels row */
    .et-labels-row {
        display: flex;
        justify-content: space-between;
        font-size: 16pt;
        font-weight: bold;
        margin-bottom: .2rem;
        padding: 0 .1rem;
    }

    /* Item + QTY */
    .et-data-row {
        display: flex;
        gap: .6rem;
        margin-bottom: .35rem;
    }

    .et-item-box {
        flex: 5;
        border: 2.5px solid #000;
        min-height: 72px;
        padding: .6rem .8rem;
        font-size: 22pt;
        font-weight: bold;
        display: flex;
        align-items: center;
    }

    .et-qty-box {
        flex: 2;
        border: 2.5px solid #000;
        min-height: 72px;
        padding: .6rem .8rem;
        font-size: 22pt;
        font-weight: bold;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* Section labels */
    .et-section-label {
        font-size: 16pt;
        font-weight: bold;
        margin-bottom: .15rem;
        margin-top: .35rem;
    }

    /* Description box */
    .et-desc-box {
        border: 2.5px solid #000;
        min-height: 72px;
        padding: .6rem .8rem;
        font-size: 22pt;
        font-weight: bold;
        margin-bottom: .35rem;
        display: flex;
        align-items: center;
    }

    /* Date box: solo columna izquierda */
    .et-date-row {
        display: flex;
    }

    .et-date-box {
        width: 28%;
        border: 2.5px solid #000;
        min-height: 72px;
        padding: .6rem .8rem;
        font-size: 18pt;
        font-weight: bold;
        display: flex;
        align-items: center;
    }

    /* ── Impresión ───────────────────────────────────────── */
    @@media print {
        @@page {
            size: landscape;
            margin: .35in .25in .5in;
        }

        /* Contador de hojas */
        @@page {
            @@bottom-right {
                content: "Hoja " counter(page) " / " counter(pages);
                font-family: Calibri, Arial, sans-serif;
                font-size: 9pt;
                color: #777;
            }
        }

        /* Hora en esquina inferior izquierda */
        @@page {
            @@bottom-left {
                content: string(print-time);
                font-family: Calibri, Arial, sans-serif;
                font-size: 9pt;
                color: #777;
            }
        }

        /* Ocultar nav y toolbar */
        .no-print,
        .navbar,
        .toolbar-et { display: none !important; }

        /* Activar marca de agua */
        .et-watermark { display: block; }

        .et-page {
            max-width: 100%;
            margin: 0;
            padding: .2rem .3rem;
            background: white;
            color: black;
        }

        .et-case-box { font-size: 5.5rem; }
    }
</style>

@code {
    [SupplyParameterFromQuery] public string? Ref { get; set; }

    List<JeDax.Models.ValeDetalle> _detalles = [];

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrEmpty(Ref)) return;
        var vale = await ValesSvc.ObtenerPorReferenciaAsync(Ref);
        _detalles = vale?.Detalles.ToList() ?? [];
    }
}
