@page "/sakuma-etiquetas"
@using JeDax.Components.Shared
@using JeDax.Helpers
@inject ValeService ValesSvc

@if (_detalles.Count == 0)
{
    <div class="empty-state">
        <Icon Name="empty-box" Size="80" />
        <h3>Sin etiquetas</h3>
        <p>No se encontraron CASEs para esta referencia.</p>
        <a href="/vales" class="btn-primary">Ir a Vales</a>
    </div>
}
else
{
    <div class="no-print toolbar-print">
        <span><strong>@Ref</strong> — @_detalles.Count etiquetas</span>
        <button onclick="window.print()" class="btn-primary"><Icon Name="download" Size="16" /> Imprimir</button>
        <a href="/vales" class="btn-outline">Ir a Vales</a>
    </div>

    @foreach (var d in _detalles)
    {
        <div class="etiqueta-page">
            <div class="etiqueta-ref">@Ref</div>
            <img class="etiqueta-qr"
                 src="data:image/png;base64,@QrHelper.ToBase64Png(d.CaseCode)"
                 alt="QR @d.CaseCode" />
            <div class="etiqueta-code">@d.CaseCode</div>
            @if (!string.IsNullOrEmpty(d.Item))
            {
                <div class="etiqueta-meta">@d.Item</div>
            }
            @if (!string.IsNullOrEmpty(d.Descripcion))
            {
                <div class="etiqueta-meta">@d.Descripcion</div>
            }
            <div class="etiqueta-meta">@d.Qty PCS</div>
        </div>
    }
}

<style>
    .toolbar-print {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
    }

    .etiqueta-page {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 80vh;
        padding: 2rem;
        text-align: center;
        break-after: page;
        page-break-after: always;
    }

    .etiqueta-ref {
        font-size: .85rem;
        color: var(--muted);
        margin-bottom: 1.5rem;
        letter-spacing: .05em;
    }

    .etiqueta-qr {
        width: 260px;
        height: 260px;
        image-rendering: pixelated;
        margin-bottom: 1.5rem;
    }

    .etiqueta-code {
        font-family: 'Courier New', monospace;
        font-size: 1.4rem;
        font-weight: bold;
        letter-spacing: .1em;
        margin-bottom: .75rem;
        color: var(--text);
    }

    .etiqueta-meta {
        font-size: .95rem;
        color: var(--muted);
        line-height: 1.6;
    }

    @@media print {
        .no-print { display: none !important; }

        .etiqueta-page {
            min-height: 100vh;
            padding: 1rem;
            background: white;
        }

        .etiqueta-ref { color: #555; }
        .etiqueta-code { color: black; }
        .etiqueta-meta { color: #444; }
    }
</style>

@code {
    [SupplyParameterFromQuery] public string? Ref { get; set; }

    List<JeDax.Models.ValeDetalle> _detalles = [];

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrEmpty(Ref)) return;
        var vale = await ValesSvc.ObtenerPorReferenciaAsync(Ref);
        _detalles = vale?.Detalles.ToList() ?? [];
    }
}
