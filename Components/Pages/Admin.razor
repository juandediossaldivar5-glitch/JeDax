@page "/admin"
@using JeDax.Models
@inject UsuarioService UsuarioSvc

<h1>Administración de Usuarios</h1>

@if (!string.IsNullOrEmpty(Error))
{
    <div class="alert-error">@Error</div>
}
@if (Ok == "1")
{
    <div class="alert-ok">Operación exitosa.</div>
}

<h3>Crear usuario</h3>
<form method="post" action="/api/admin/crear-usuario" class="form-section">
    <label>Username</label>
    <input name="username" required class="input" />
    <label>Contraseña</label>
    <input name="password" required class="input" />
    <label>Rol</label>
    <select name="rol" required class="input">
        @foreach (var r in Enum.GetValues<RolUsuario>())
        {
            <option value="@r">@r</option>
        }
    </select>
    <button type="submit" class="btn-primary">Crear</button>
</form>

<h3>Usuarios existentes</h3>
<table class="tabla">
    <thead>
        <tr><th>Username</th><th>Rol</th><th>Activo</th><th>Cambiar rol</th><th>Cambiar password</th><th></th></tr>
    </thead>
    <tbody>
        @foreach (var u in _usuarios)
        {
            <tr>
                <td>@u.Username</td>
                <td>@u.Rol</td>
                <td>@(u.Activo ? "Sí" : "No")</td>
                <td>
                    <form method="post" action="/api/admin/cambiar-rol" style="display:flex;gap:.3rem">
                        <input type="hidden" name="userId" value="@u.Id" />
                        <select name="rol" class="input" style="max-width:120px;padding:.2rem">
                            @foreach (var r in Enum.GetValues<RolUsuario>())
                            {
                                <option value="@r" selected="@(u.Rol == r)">@r</option>
                            }
                        </select>
                        <button type="submit" class="btn-sm">OK</button>
                    </form>
                </td>
                <td>
                    <form method="post" action="/api/admin/cambiar-password" style="display:flex;gap:.3rem">
                        <input type="hidden" name="userId" value="@u.Id" />
                        <input type="password" name="password" placeholder="Nueva" required class="input" style="max-width:130px;padding:.2rem" />
                        <button type="submit" class="btn-sm">OK</button>
                    </form>
                </td>
                <td>
                    <form method="post" action="/api/admin/toggle-activo" style="display:inline">
                        <input type="hidden" name="userId" value="@u.Id" />
                        <button type="submit" class="btn-sm @(u.Activo ? "btn-sm-danger" : "")">
                            @(u.Activo ? "Desactivar" : "Activar")
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

@code {
    [SupplyParameterFromQuery] public string? Error { get; set; }
    [SupplyParameterFromQuery] public string? Ok { get; set; }

    List<Usuario> _usuarios = [];

    protected override async Task OnInitializedAsync()
    {
        _usuarios = await UsuarioSvc.ListarAsync();
    }
}
